<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Bảng Điều Khiển Thói Quen - Thái Tử</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Inter', sans-serif; background-color: #0f172a; color: #f8fafc; }
    .custom-checkbox:checked { background-color: #10b981; border-color: #10b981; }
  </style>
</head>
<body class="min-h-screen p-6 md:p-10">

  <div class="max-w-6xl mx-auto space-y-8">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-800 pb-6">
      <div>
        <h1 class="text-3xl font-bold bg-gradient-to-r from-emerald-400 to-cyan-400 bg-clip-text text-transparent">
          Habit & Streak Dashboard
        </h1>
        <p class="text-slate-400 text-sm mt-1">Theo dõi mục tiêu hằng ngày & thống kê chuỗi liên tiếp trong tuần</p>
      </div>
      
      <!-- Form thêm thói quen mới -->
      <div class="flex gap-2">
        <input id="newHabitInput" type="text" placeholder="Thêm mục tiêu mới..." 
          class="bg-slate-800 border border-slate-700 rounded-lg px-4 py-2 text-sm focus:outline-none focus:border-emerald-500 w-64 text-slate-100" />
        <button onclick="addHabit()" 
          class="bg-emerald-500 hover:bg-emerald-600 text-slate-950 font-semibold px-4 py-2 rounded-lg text-sm transition">
          + Thêm
        </button>
      </div>
    </div>

    <!-- Thẻ KPI tóm tắt -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="bg-slate-800/70 border border-slate-700/60 rounded-xl p-5">
        <span class="text-slate-400 text-xs uppercase font-semibold tracking-wider">Hoàn thành hôm nay</span>
        <div class="flex items-baseline gap-2 mt-2">
          <span id="todayProgress" class="text-3xl font-bold text-emerald-400">0/0</span>
          <span id="todayPercent" class="text-sm text-slate-400">(0%)</span>
        </div>
      </div>

      <div class="bg-slate-800/70 border border-slate-700/60 rounded-xl p-5">
        <span class="text-slate-400 text-xs uppercase font-semibold tracking-wider">Chuỗi (Streak) cao nhất hiện tại</span>
        <div class="flex items-baseline gap-2 mt-2">
          <span id="bestStreak" class="text-3xl font-bold text-amber-400">0</span>
          <span class="text-sm text-slate-400">ngày liên tiếp 🔥</span>
        </div>
      </div>

      <div class="bg-slate-800/70 border border-slate-700/60 rounded-xl p-5">
        <span class="text-slate-400 text-xs uppercase font-semibold tracking-wider">Hiệu suất cả tuần</span>
        <div class="flex items-baseline gap-2 mt-2">
          <span id="weeklyRate" class="text-3xl font-bold text-cyan-400">0%</span>
          <span class="text-sm text-slate-400">mục tiêu đạt được</span>
        </div>
      </div>
    </div>

    <!-- Bảng Ma trận Thói quen 7 ngày -->
    <div class="bg-slate-800/60 border border-slate-700/60 rounded-xl p-6 overflow-x-auto">
      <div class="flex justify-between items-center mb-4">
        <h2 class="text-lg font-semibold text-slate-200">Nhật ký thực hiện (Thứ 2 - Chủ Nhật)</h2>
        <button onclick="resetData()" class="text-xs text-rose-400 hover:underline">Khôi phục mặc định</button>
      </div>
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="border-b border-slate-700 text-slate-400 text-xs uppercase">
            <th class="py-3 px-4 w-1/3">Mục tiêu hằng ngày</th>
            <th class="py-3 px-2 text-center">T2</th>
            <th class="py-3 px-2 text-center">T3</th>
            <th class="py-3 px-2 text-center">T4</th>
            <th class="py-3 px-2 text-center">T5</th>
            <th class="py-3 px-2 text-center">T6</th>
            <th class="py-3 px-2 text-center">T7</th>
            <th class="py-3 px-2 text-center">CN</th>
            <th class="py-3 px-4 text-right">Chuỗi (Streak)</th>
            <th class="py-3 px-2 text-center">Xóa</th>
          </tr>
        </thead>
        <tbody id="habitTableBody" class="divide-y divide-slate-700/50 text-sm">
          <!-- Render bằng JS -->
        </tbody>
      </table>
    </div>

    <!-- Khu vực Biểu đồ -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <!-- Biểu đồ 1: Số mục tiêu hoàn thành theo từng ngày -->
      <div class="bg-slate-800/60 border border-slate-700/60 rounded-xl p-6">
        <h3 class="text-base font-semibold text-slate-200 mb-4">Tiến độ hoàn thành trong tuần (Mục tiêu/Ngày)</h3>
        <canvas id="dailyChart" height="200"></canvas>
      </div>

      <!-- Biểu đồ 2: So sánh chuỗi ngày liên tiếp của từng thói quen -->
      <div class="bg-slate-800/60 border border-slate-700/60 rounded-xl p-6">
        <h3 class="text-base font-semibold text-slate-200 mb-4">Biểu đồ Chuỗi liên tiếp (Streak) theo thói quen</h3>
        <canvas id="streakChart" height="200"></canvas>
      </div>
    </div>
  </div>

  <script>
    const DAYS = ['T2', 'T3', 'T4', 'T5', 'T6', 'T7', 'CN'];
    
    const DEFAULT_HABITS = [
      { id: 1, name: "Luyện thuật toán C++ / Python (60p)", days: [true, true, true, true, false, false, false] },
      { id: 2, name: "Đọc paper AI & Làm bài tập Data", days: [true, true, false, true, false, false, false] },
      { id: 3, name: "Phân tích cổ phiếu & Bảng điện", days: [true, true, true, true, false, false, false] },
      { id: 4, name: "Luyện đề IELTS (Reading / Listening)", days: [false, true, true, true, false, false, false] },
      { id: 5, name: "Tập thể dục / Chơi Guitar", days: [true, false, true, true, false, false, false] }
    ];

    let habits = JSON.parse(localStorage.getItem('thaitu_habits')) || DEFAULT_HABITS;
    let dailyChartInstance = null;
    let streakChartInstance = null;

    // Tính chuỗi ngày liên tiếp dài nhất tính đến hiện tại (hoặc trong tuần)
    function calculateStreak(daysArray) {
      let currentStreak = 0;
      let maxStreak = 0;
      for (let completed of daysArray) {
        if (completed) {
          currentStreak++;
          if (currentStreak > maxStreak) maxStreak = currentStreak;
        } else {
          currentStreak = 0;
        }
      }
      return maxStreak;
    }

    // Xác định ngày hiện tại trong tuần (0: T2 ... 6: CN)
    function getTodayIndex() {
      const jsDay = new Date().getDay(); // 0 là CN, 1-6 là T2-T7
      return jsDay === 0 ? 6 : jsDay - 1;
    }

    function saveData() {
      localStorage.setItem('thaitu_habits', JSON.stringify(habits));
      renderDashboard();
    }

    function toggleDay(habitId, dayIndex) {
      const habit = habits.find(h => h.id === habitId);
      if (habit) {
        habit.days[dayIndex] = !habit.days[dayIndex];
        saveData();
      }
    }

    function addHabit() {
      const input = document.getElementById('newHabitInput');
      const name = input.value.trim();
      if (!name) return;
      habits.push({
        id: Date.now(),
        name: name,
        days: [false, false, false, false, false, false, false]
      });
      input.value = '';
      saveData();
    }

    function deleteHabit(habitId) {
      habits = habits.filter(h => h.id !== habitId);
      saveData();
    }

    function resetData() {
      localStorage.removeItem('thaitu_habits');
      habits = JSON.parse(JSON.stringify(DEFAULT_HABITS));
      renderDashboard();
    }

    function renderDashboard() {
      const tbody = document.getElementById('habitTableBody');
      tbody.innerHTML = '';
      const todayIdx = getTodayIndex();

      let todayCompleted = 0;
      let totalChecks = 0;
      let highestStreak = 0;

      habits.forEach(habit => {
        const streak = calculateStreak(habit.days);
        if (streak > highestStreak) highestStreak = streak;
        if (habit.days[todayIdx]) todayCompleted++;
        totalChecks += habit.days.filter(Boolean).length;

        const tr = document.createElement('tr');
        tr.className = "hover:bg-slate-800/40 transition";

        let daysHtml = '';
        habit.days.forEach((checked, idx) => {
          const isToday = idx === todayIdx ? 'ring-2 ring-emerald-500/40 rounded' : '';
          daysHtml += `
            <td class="py-3 px-2 text-center">
              <input type="checkbox" ${checked ? 'checked' : ''} 
                onchange="toggleDay(${habit.id}, ${idx})"
                class="w-5 h-5 rounded bg-slate-700 border-slate-600 text-emerald-500 focus:ring-0 cursor-pointer ${isToday}">
            </td>`;
        });

        tr.innerHTML = `
          <td class="py-3 px-4 font-medium text-slate-200">${habit.name}</td>
          ${daysHtml}
          <td class="py-3 px-4 text-right font-semibold">
            <span class="px-2.5 py-1 rounded-full text-xs ${streak >= 3 ? 'bg-amber-500/20 text-amber-300 border border-amber-500/30' : 'bg-slate-700 text-slate-300'}">
              ${streak} ngày 🔥
            </span>
          </td>
          <td class="py-3 px-2 text-center">
            <button onclick="deleteHabit(${habit.id})" class="text-slate-500 hover:text-rose-400 transition">✕</button>
          </td>
        `;
        tbody.appendChild(tr);
      });

      // Cập nhật KPI
      const totalHabits = habits.length;
      const pctToday = totalHabits ? Math.round((todayCompleted / totalHabits) * 100) : 0;
      const pctWeek = totalHabits ? Math.round((totalChecks / (totalHabits * 7)) * 100) : 0;

      document.getElementById('todayProgress').innerText = `${todayCompleted}/${totalHabits}`;
      document.getElementById('todayPercent').innerText = `(${pctToday}%)`;
      document.getElementById('bestStreak').innerText = highestStreak;
      document.getElementById('weeklyRate').innerText = `${pctWeek}%`;

      updateCharts();
    }

    function updateCharts() {
      // Dữ liệu biểu đồ theo ngày (T2 -> CN)
      const dailyCounts = DAYS.map((_, dayIdx) => 
        habits.reduce((sum, h) => sum + (h.days[dayIdx] ? 1 : 0), 0)
      );

      // Dữ liệu biểu đồ Streak theo từng thói quen
      const habitLabels = habits.map(h => h.name.length > 25 ? h.name.substring(0, 25) + '...' : h.name);
      const streakCounts = habits.map(h => calculateStreak(h.days));

      const ctxDaily = document.getElementById('dailyChart').getContext('2d');
      if (dailyChartInstance) dailyChartInstance.destroy();
      dailyChartInstance = new Chart(ctxDaily, {
        type: 'bar',
        data: {
          labels: DAYS,
          datasets: [{
            label: 'Mục tiêu hoàn thành',
            data: dailyCounts,
            backgroundColor: 'rgba(16, 185, 129, 0.7)',
            borderColor: '#10b981',
            borderWidth: 1,
            borderRadius: 6
          }]
        },
        options: {
          scales: {
            y: { beginAtZero: true, max: Math.max(habits.length, 5), ticks: { stepSize: 1, color: '#94a3b8' }, grid: { color: '#334155' } },
            x: { ticks: { color: '#94a3b8' }, grid: { display: false } }
          },
          plugins: { legend: { display: false } }
        }
      });

      const ctxStreak = document.getElementById('streakChart').getContext('2d');
      if (streakChartInstance) streakChartInstance.destroy();
      streakChartInstance = new Chart(ctxStreak, {
        type: 'bar',
        data: {
          labels: habitLabels,
          datasets: [{
            label: 'Chuỗi ngày liên tiếp (Streak)',
            data: streakCounts,
            backgroundColor: 'rgba(245, 158, 11, 0.75)',
            borderColor: '#f59e0b',
            borderWidth: 1,
            borderRadius: 6
          }]
        },
        options: {
          indexAxis: 'y',
          scales: {
            x: { beginAtZero: true, max: 7, ticks: { stepSize: 1, color: '#94a3b8' }, grid: { color: '#334155' } },
            y: { ticks: { color: '#e2e8f0' }, grid: { display: false } }
          },
          plugins: { legend: { display: false } }
        }
      });
    }

    // Khởi chạy lần đầu
    renderDashboard();
  </script>
</body>
</html>
